# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
# Self-contained offline build. The generated review artefact IS committed on
# purpose so it can be downloaded without a build step; everything else in the
# folder stays ignored.
standalone/*
!standalone/rootcause-ai.html
dist-ssr/
.ssr-smoke/
*.local

# Env files (never commit credentials)
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log

# TypeScript incremental build info
*.tsbuildinfo

# The repository's root .gitignore ignores *any* directory named `lib/`
# (Python packaging template). Our source directory must be tracked, or a
# fresh clone cannot build. Re-include it explicitly.
!lib/
!lib/**
