{
  "name": "rootcause-ai-web",
  "private": true,
  "version": "1.0.0-phase1",
  "type": "module",
  "description": "RootCause AI \u2014 premium frontend (Phase 1: static, replay-driven UI)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "smoke": "vite build --ssr scripts/ssr-smoke.tsx --outDir .ssr-smoke --emptyOutDir && node .ssr-smoke/ssr-smoke.js",
    "smoke:panels": "vite build --ssr scripts/panel-check.tsx --outDir .ssr-smoke --emptyOutDir && node .ssr-smoke/panel-check.js",
    "build:standalone": "vite build --config vite.standalone.config.ts && node -e \"require('node:fs').renameSync('standalone/index.html','standalone/rootcause-ai.html')\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
