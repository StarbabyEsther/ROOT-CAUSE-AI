# RootCause AI — frontend configuration (Phase 1 defaults shown)
#
# Phase 1 ships in replay mode: investigations play back recorded demonstration
# data. No credentials are needed, and no secrets may ever be exposed to the
# browser — anything prefixed with VITE_ is bundled into the client.

# replay | live
VITE_API_MODE=replay

# Leave empty for same-origin /api/* (dev proxy or a Pages Function).
# Set to the deployed adapter origin if it is served from a different host,
# e.g. VITE_API_BASE=https://rootcause-ai-api.fly.dev
VITE_API_BASE=

# Only used by the Vite dev server proxy, never by the browser bundle.
# API_PROXY_TARGET=http://127.0.0.1:8000
