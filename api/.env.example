# RootCause AI — API adapter configuration
# Copy to .env for local development. NEVER commit a filled-in copy.
#
# Credentials are read from the environment exactly as the existing backend does.
# Leave them empty here; supply them through your shell or the platform's secret
# store. The adapter never returns them through the API.

# --- required for LIVE runs only -------------------------------------------
LIVE_RUNS_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_MODEL=
CONTREE_PROJECT_ID=
CONTREE_TOKEN=

# --- rate limits (chosen for a public, no-login demo) ----------------------
RC_PER_IP_HOUR=2
RC_PER_IP_DAY=5
RC_GLOBAL_DAY=30
RC_MAX_CONCURRENT=1

# --- storage ---------------------------------------------------------------
# Must be a persistent volume in production so limits survive restarts.
RC_STATE_DIR=/tmp/rcai-state
RC_WORKSPACE_ROOT=/tmp/rcai-work

# --- deployment ------------------------------------------------------------
# Comma-separated origins allowed by CORS.
RC_ALLOWED_ORIGINS=http://localhost:5173
# Set to true only behind a trusted proxy (Fly.io, Cloudflare) so X-Forwarded-For
# is honoured for per-IP limits.
RC_TRUST_PROXY=false
